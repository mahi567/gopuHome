---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import StayCard from "../components/StayCard.astro";
import Cta from "../components/Cta.astro";
import Marquee from "../components/Marquee.astro";
import GoogleReviews from "../components/GoogleReviews.astro";
import Stickers from "../components/Stickers.astro";
import site from "../data/site.json";
import { TYPES, getStays, staysOfType } from "../lib/stays.js";

const stays = await getStays();
const groups = TYPES.map((t) => ({ type: t, list: staysOfType(stays, t.id) })).filter((g) => g.list.length);
const allText = "Pick a type below to see only those properties. Tap a card for photos, details and location.";
---
<Base
  page="home"
  title="gopuhomestays — PG, Co-living, Flats & Guest Rooms in Bengaluru"
  description="Gopu Homestays: co-living PGs, ladies PG, flats and guest rooms. A trusted co-living brand with 1,000+ beds across Bengaluru and Hyderabad."
>
  <section class="hero">
    <div class="container">
      <div>
        <span class="eyebrow">Welcome to gopuhomestays</span>
        <h1>A comfortable stay for <em>every need</em></h1>
        <p class="lead">Co-living PGs, a ladies PG, flats and guest rooms from a trusted co-living brand with over 1,000 beds across Bengaluru and Hyderabad.</p>
        <div class="hero-actions">
          <a class="btn btn-accent" href="#stay-types">Explore our stays</a>
          <a class="btn btn-light" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent("Hi, I have an enquiry about Gopu Home Stay.")}`} target="_blank" rel="noopener"><Icon name="whatsapp" /><span>Enquire on WhatsApp</span></a>
        </div>
        <ul class="hero-points">
          <li><Icon name="check" />One contact number</li>
          <li><Icon name="check" />24/7 security</li>
          <li><Icon name="check" />Home-style meals</li>
        </ul>
      </div>
      <aside class="glass">
        <h3>Gopu Home Stay at a glance</h3>
        <p>Trusted by working professionals and students.</p>
        <div class="glass-stats">
          <div><b>2018</b><small>Started with 72 beds</small></div>
          <div><b data-count="1000" data-suffix="+">1,000+</b><small>Beds today</small></div>
          <div><b>2</b><small>Cities: Bengaluru &amp; Hyderabad</small></div>
          <div><b>24/7</b><small>Security &amp; CCTV</small></div>
        </div>
        <a class="btn btn-accent btn-block" href="/stays/">View all stays</a>
        <div class="glass-contact">
          <a href={`tel:${site.phoneDial}`}><Icon name="phone" /><span>{site.phoneDisplay}</span></a>
          <a href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent("Hi, I have an enquiry about Gopu Home Stay.")}`} target="_blank" rel="noopener"><Icon name="whatsapp" /><span>Enquire on WhatsApp</span></a>
        </div>
      </aside>
    </div>
  </section>

  <Marquee />

  <section class="section" id="stay-types">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our properties</span>
        <h2>List of properties</h2>
        <p id="stays-sub">{allText}</p>
      </div>
      <!-- The script in src/scripts/site.js shows/hides cards when these buttons are used. -->
      <div class="filters" id="filters" data-inline>
        <button data-type="all" data-sub={allText} class="active">All properties ({stays.length})</button>
        {groups.map(({ type, list }) => (
          <button data-type={type.id} data-sub={`${type.blurb} Best for: ${type.bestFor.toLowerCase()}.`}>{type.name} ({list.length})</button>
        ))}
      </div>
      <div class="grid grid-3" id="stays-grid">
        {stays.map((stay) => <StayCard stay={stay} />)}
        <p class="empty" id="stays-empty" hidden>No properties to show here right now.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container teaser">
      <div class="teaser-photos">
        <img src="/images/g3/double-room.jpg" alt="A double room at Gopu Home Stay" loading="lazy" />
        <img src="/images/g3/dining.jpg" alt="Dining hall at Gopu Home Stay" loading="lazy" />
      </div>
      <div class="prose">
        <span class="eyebrow">About us</span>
        <h2>From 72 beds to over 1,000</h2>
        <p>What began as a humble initiative with 72 beds in 2018 has grown into a trusted co-living brand across Bengaluru and Hyderabad. We offer a safe, comfortable and modern living experience for working professionals and students.</p>
        <ul class="ticks">
          <li><Icon name="check" />Premium buildings &amp; spacious rooms</li>
          <li><Icon name="check" />Zero-compromise hygiene</li>
          <li><Icon name="check" />24/7 high security</li>
          <li><Icon name="check" />Hygienic &amp; nutritious food</li>
        </ul>
        <p><a class="btn btn-primary" href="/about/">More about us</a></p>
      </div>
    </div>
  </section>

  <GoogleReviews />

  <Stickers show={["bed", "tv", "gym", "games", "shield", "clean"]} />

  <Cta title="Ready to book or have a question?" text="Call us, or message us on WhatsApp." />
</Base>
