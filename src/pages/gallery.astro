---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { TYPES, getStays } from "../lib/stays.js";

// Every photo of every property, each shown once (a photo shared by two
// properties is credited to the first one that lists it).
const stays = await getStays();
const seen = new Set();
const photos = [];
for (const stay of stays) {
  for (const p of stay.photos) {
    if (!p.image || seen.has(p.image)) continue;
    seen.add(p.image);
    photos.push({ ...p, stay });
  }
}
const typesWithPhotos = TYPES.filter((t) => photos.some((p) => p.stay.type === t.id));
const count = (typeId) => photos.filter((p) => p.stay.type === typeId).length;
---
<Base
  page="gallery"
  title="Gallery — gopuhomestays"
  description="Photos of Gopu Homestays PGs, flats, studio rooms and lodges in Bengaluru: rooms, buildings, dining, gym and more."
>
  <section class="page-hero" style="--hero-img:url('/images/g1/games.jpg')">
    <div class="container">
      <h1>Gallery</h1>
      <p>{photos.length} photos from all our properties. Tap any photo to view it larger.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="filters" id="gallery-filters">
        <button data-type="all" class="active">All photos ({photos.length})</button>
        {typesWithPhotos.map((t) => <button data-type={t.id}>{t.name} ({count(t.id)})</button>)}
      </div>
      <div class="g-grid" id="gallery-grid">
        {photos.map((p) => (
          <button
            class="g-tile"
            data-type={p.stay.type}
            data-src={p.image}
            data-title={p.stay.name}
            data-caption={p.caption}
            data-href={`/stays/${p.stay.id}/`}
            aria-label={`${p.stay.name}${p.caption ? " — " + p.caption : ""}`}
          >
            <img src={p.image} alt={`${p.stay.name}${p.caption ? " — " + p.caption : ""}`} loading="lazy" onerror="this.closest('.g-tile').remove()" />
            <span class="g-cap"><b>{p.caption || p.stay.name}</b>{p.caption && <small>{p.stay.name}</small>}</span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <Cta title="Like what you see?" text="Call us to visit any property or check what's available." />
</Base>
